    "db:studio": "drizzle-kit studio",
    "postbuild": "node scripts/clean-standalone.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
