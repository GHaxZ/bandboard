{
  "name": "bandboard-v3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set -a; . ./.env 2>/dev/null; set +a; next dev",
    "build": "DATABASE_PATH=:memory: MIGRATE_ON_BOOT=0 next build",
    "start": "set -a; . ./.env 2>/dev/null; set +a; next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
