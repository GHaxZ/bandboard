# Registration is closed unless an invite is configured or open mode is explicit.
# invite (default), closed, or open.
REGISTRATION_MODE=invite
BAND_SECRET=

# Canonical browser origin. Required behind an HTTPS reverse proxy.
# APP_ORIGIN=https://band.example.com
# Only enable if the backend is hidden and the proxy overwrites X-Real-IP.
TRUST_PROXY=false

# Optional YouTube Data API key (otherwise HTML search is used).
YOUTUBE_API_KEY=
PORT=3000
# The backend binds to loopback on the Docker host by default.
BIND_ADDRESS=127.0.0.1
BACKUP_KEEP=10
# Optional age public recipient; snapshots are encrypted without storing a private key.
# BACKUP_AGE_RECIPIENT=age1...
